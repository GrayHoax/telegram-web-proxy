# ---- Required --------------------------------------------------------------
# Domain name whose A record points to this server.
TPROXY_HOSTNAME=proxy.example.com

# ---- Optional --------------------------------------------------------------
# E-mail for Let's Encrypt notifications (TLS_MODE=auto only).
ACME_EMAIL=

# auto = the container obtains a certificate itself (needs ports 80 and 443)
# off  = plain HTTP on 8080, TLS is terminated by your own reverse proxy
TLS_MODE=auto

# 32 hex characters. Empty = generated on first start and kept in the volume.
TPROXY_SECRET=

# Random URI prefix of the proxy. Empty = generated on first start
# (16 random characters), "none" = serve the proxy at the site root.
TPROXY_BASE_PATH=

# https | https-lanes | websocket | websocket-lanes
TPROXY_CARRIER_MODE=https

# Public IPv4 of the server if auto-detection fails (needed by MTProxy behind NAT).
MTPROXY_PUBLIC_IP=

# MTProxy worker processes and connections per worker.
MTPROXY_WORKERS=1
MTPROXY_MAX_CONNECTIONS=4096

# Print the connection link into `docker compose logs` on start (1/0).
PRINT_LINK_ON_START=1
