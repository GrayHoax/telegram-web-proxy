# Public domain name of the cover site (must match the Ingress host).
TPROXY_HOSTNAME=proxy.example.com
# TLS is terminated by the Ingress controller.
TLS_MODE=off
# Addresses of Ingress controller pods whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=private_ranges 100.64.0.0/10
TPROXY_CARRIER_MODE=https
MTPROXY_WORKERS=1
MTPROXY_MAX_CONNECTIONS=4096
# Egress public IPv4 of the nodes, if auto-detection is wrong.
MTPROXY_PUBLIC_IP=
# Do not print the secret into pod logs; use: kubectl exec ... -- show-link
PRINT_LINK_ON_START=0
