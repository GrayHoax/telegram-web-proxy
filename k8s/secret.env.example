# Copy to secret.env (deploy.sh does it automatically with random values).
# 32 hex characters: openssl rand -hex 16
TPROXY_SECRET=
# Random URI prefix of the proxy: head -c 10 /dev/urandom | base32 | tr A-Z a-z
TPROXY_BASE_PATH=
# Relay token key, 64 hex characters: openssl rand -hex 32
# Required without a PVC (components/no-pvc); with a PVC it overrides /data/relay/token.key.
TPROXY_TOKEN_KEY=
